# Copy to .env and fill in. Never commit .env.

# Slack app (Socket Mode): app-level token (xapp-...) and bot token (xoxb-...)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Notion internal integration token (share your PRD/TRD pages with the integration)
NOTION_TOKEN=

# Read-only user on the database REPLICA (see README: "Create the read-only database user")
READONLY_DB_URL=postgresql://askcite_ro:CHANGE_ME@replica-host:5432/yourdb

# HTTPS git token (only if you use an https:// repo URL with token_env: GITLAB_TOKEN in sources.yaml)
GITLAB_TOKEN=
# SSH deploy key file on the host (mounted into the container as /secrets/git_ssh_key)
GIT_SSH_KEY_FILE=

# AI provider key for the cloud model in sources.yaml (pick the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Askcite's own storage database (the docker compose default works as-is)
ASKCITE_DB_PASSWORD=askcite
