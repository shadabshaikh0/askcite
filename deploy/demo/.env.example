# Copy to .env (next to docker-compose.yml) and fill in.

# Free key from https://aistudio.google.com → Get API key (the demo data is fake, so the free tier is fine)
GEMINI_API_KEY=
# Optional: another model (any LiteLLM name), e.g. gemini/gemini-flash-lite-latest for higher free limits
ASKCITE_MODEL=gemini/gemini-flash-latest
# Used at once when the model above is overloaded (Google answers 503 "high demand" at busy times)
ASKCITE_FALLBACK_MODELS=gemini/gemini-flash-lite-latest

# Your server's public address. Without a domain use <name>.<public-ip>.sslip.io, e.g. askcite.140.238.10.20.sslip.io
# To try it on your laptop first, use http://localhost (plain HTTP, no certificate warning).
DEMO_HOST=http://localhost

# Password for the admin pages (user: admin) — visitors never need it
ASKCITE_ADMIN_PASSWORD=change-me-to-something-long

# Askcite's own database password (only reachable inside Docker)
POSTGRES_PASSWORD=change-me-too
